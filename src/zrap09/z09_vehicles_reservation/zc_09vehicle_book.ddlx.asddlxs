@Metadata.layer: #CORE
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'BookingID'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'BookingID'
annotate view ZC_09VEHICLE_BOOK with
{
 
  @UI.facet: [ {
    id: 'BookingDetails',
    type: #IDENTIFICATION_REFERENCE,
    label: 'Detalles de la Reserva',
    position: 10
  } ]

  @UI.hidden: true
  BookingID;

  @UI.lineItem: [ 
    { position: 10, label: 'Cliente' },
    { type: #FOR_ACTION, dataAction: 'cancelBooking', label: 'Cancelar' }
  ]
  @UI.identification: [ 
    { position: 10, label: 'Cliente' },
    { type: #FOR_ACTION, dataAction: 'cancelBooking', label: 'Cancelar' }
  ]
  CustomerName;

  @UI.lineItem: [ { position: 20, label: 'Vehículo' } ]
  @UI.identification: [ { position: 20, label: 'Vehículo' } ]
  Vehicle;

  @UI.lineItem: [ { position: 30, label: 'Fecha Inicio' } ]
  @UI.identification: [ { position: 30, label: 'Fecha Inicio' } ]
  StartDate;

  @UI.lineItem: [ { position: 40, label: 'Fecha Fin' } ]
  @UI.identification: [ { position: 40, label: 'Fecha Fin' } ]
  EndDate;

  
  -- Configuración de Criticidad Semántica vinculada al campo Status
  @UI.lineItem: [ { position: 50, importance: #HIGH, label: 'Estado', criticality: 'StatusCriticality' } ]
  @UI.identification: [ { position: 50, label: 'Estado', criticality: 'StatusCriticality' } ]
  Status;
  

  @UI.lineItem: [ { position: 60, label: 'Días Totales' } ]
  @UI.identification: [ { position: 60, label: 'Días Totales' } ]
  Totaldays;

  @UI.lineItem: [ { position: 70, label: 'Precio Total' } ]
  @UI.identification: [ { position: 70, label: 'Precio Total' } ]
  TotalPrice;
  
  -- Ocultar campo de moneda individual (se formatea junto al precio)
  @UI.hidden: true
  Currency;

  -- Ocultar el campo auxiliar de criticidad numérico
  @UI.hidden: true
  StatusCriticality;

  -- Ocultar campos de auditoría administrativa
  @UI.hidden: true
  Createdby;

  @UI.hidden: true
  Createdat;

  @UI.hidden: true
  Lastchangedby;

  @UI.hidden: true
  Lastchangedat;

  @UI.hidden: true
  Locallastchanged;
}





