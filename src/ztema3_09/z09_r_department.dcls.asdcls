@EndUserText.label: 'Department (Access Control)'
@MappingRole: true
define role Z09_R_DEPARTMENT {
    grant 
        select
            on
                Z09_R_DEPARTMENT
                    where
                        ( ID ) = 
                        aspect pfcg_auth( 
                        Z09DPMNT, 
                        Z09DPMNT,
                        ACTVT = '03');
                        
}